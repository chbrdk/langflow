# Overlay the projects-a frontend on the official 1.13.2 image.
# The Python plugin still starts from the Coolify command.

FROM node:24-bookworm AS frontend

WORKDIR /src
COPY src/frontend/package.json src/frontend/package-lock.json ./
RUN PUPPETEER_SKIP_DOWNLOAD=true npm ci
COPY src/frontend/ ./
RUN NODE_OPTIONS=--max-old-space-size=4096 npm run build

FROM langflowai/langflow:1.13.2

USER root
COPY --from=frontend /src/build /tmp/frontend-build
RUN /app/.venv/bin/python -c 'import pathlib, shutil, langflow; target = pathlib.Path(langflow.__file__).parent / "frontend"; shutil.rmtree(target, ignore_errors=True); shutil.copytree("/tmp/frontend-build", target); print(target)'
USER 1000
